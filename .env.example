# Copie ce fichier en .env puis remplis les valeurs (le fichier .env n'est jamais commite)
DB_PASSWORD=jobtracker
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum

# IA gratuite : cree une cle sur https://console.groq.com/keys
