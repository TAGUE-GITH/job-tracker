# Copie ce fichier en .env puis remplis les valeurs (le fichier .env n'est jamais commite)
DB_PASSWORD=jobtracker
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum

# IA gratuite : cree une cle sur https://console.groq.com/keys
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b

# Offres d'emploi dans l'application (au moins une source, gratuites)
# La bonne alternance (offres d'alternance) : cle sur https://api.apprentissage.beta.gouv.fr
LBA_API_KEY=
# France Travail (API Offres d'emploi v2, plus en acces libre) : https://francetravail.io
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# Jooble (tous contrats) : cle gratuite sur https://fr.jooble.org/api/about
JOOBLE_API_KEY=
# fr.jooble.org pour une cle demandee sur le site francais
JOOBLE_HOST=jooble.org
# Adzuna (payant, 25 appels d'essai) : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
